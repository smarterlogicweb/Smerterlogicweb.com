# =========================
# Runtime (Next.js public)
# =========================

# Analytics (choose one)
NEXT_PUBLIC_ANALYTICS_PROVIDER=ga
# If provider = ga (Google Analytics 4)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# If you prefer Plausible or Umami (optional, leave empty if GA)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=smarterlogicweb.com
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.umami.is/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Marketing pixels (loaded only after marketing consent)
# Optional: add if you run Ads/insights
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=6

# UI / contact
NEXT_PUBLIC_PHONE=+33 6 12 34 56 78

# Logos (optional, defaults already set in code)
# Example values if you store files in /public/logos/
# NEXT_PUBLIC_LOGO_HEADER_LIGHT=/logos/logo-header-blue.svg
# NEXT_PUBLIC_LOGO_HEADER_DARK=/logos/logo-header-white.svg
# NEXT_PUBLIC_LOGO_HEADER_SMALL_LIGHT=/logos/logo-header-blue-small.svg
# NEXT_PUBLIC_LOGO_HEADER_SMALL_DARK=/logos/logo-header-white.svg
# NEXT_PUBLIC_LOGO_FOOTER=/logos/logo-footer.svg

# Pricing: Stripe Payment Links (optional)
NEXT_PUBLIC_STRIPE_LINK_ESSENTIEL=
NEXT_PUBLIC_STRIPE_LINK_PROFESSIONNEL=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=

# HubSpot (optional if you use embed forms)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=
NEXT_PUBLIC_HUBSPOT_REGION=na1

# Sanity Studio dashboard deploy hook button (optional)
NEXT_PUBLIC_VERCEL_DEPLOY_HOOK_URL=


# =========================
# Server-side only
# =========================

# Email (Resend) — used by /api/contact-email to send messages
RESEND_API_KEY=
CONTACT_EMAIL_TO=contact@smarterlogicweb.com
CONTACT_EMAIL_FROM=noreply@smarterlogicweb.com

# Sanity (Headless CMS)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-11-14
# Import script only (local usage):
# SANITY_TOKEN=

# Blog scheduling / publishing (optional)
# Use Europe/Paris local hour if you want predictable publish times
BLOG_SOURCE=sanity
BLOG_PUBLISH_LOCAL_HOUR=9
BLOG_PUBLISH_TZ=Europe/Paris
BLOG_INITIAL_PUBLISH_COUNT_FR=10
BLOG_INITIAL_PUBLISH_COUNT_EN=10
BLOG_PUBLISH_OVERRIDE_FR=
BLOG_PUBLISH_OVERRIDE_EN=

# Studio protection (simple auth for /studio)
# Use either Basic Auth or a single access token
STUDIO_BASIC_AUTH_USER=
STUDIO_BASIC_AUTH_PASS=
STUDIO_ACCESS_TOKEN=

# IndexNow (optional)
INDEXNOW_HOST=
INDEXNOW_KEY=


# =========================
# CI / Deployment
# =========================
# If you want GitHub Actions to trigger a deploy on your host:
# (Add in GitHub → Settings → Secrets → Actions)
# - VERCEL_DEPLOY_HOOK_URL
# - NETLIFY_BUILD_HOOK_URL

# Local development tip:
# Copy this file to .env.local and fill values that you need while debugging.